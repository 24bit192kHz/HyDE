{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "CachyOS_small",
        "padding": {
            "left": 0,
            "right": 3
        }
    },
    "display": {
        "color": "blue",
        "separator": " : "
    },
    "modules": [
        {
            "type": "title"
        },
        {
            "type": "custom",
            "format": "───────────────────────────────"
        },
        {
            "type": "os",
            "key": "Distro    "
        },
        {
            "type": "kernel",
            "key": "Kernel    "
        },
        {
            "type": "packages",
            "key": "Packages  ",
            "format": "{all}"
        },
        {
            "type": "wm",
            "key": "DE/WM     "
        },
        {
            "type": "cpu",
            "key": "CPU       "
        },
        {
            "type": "gpu",
            "key": "GPU       "
        },
        {
             "type": "command",
             "key": "RAM       ",
             "text": "/home/btw/mhm/scripts/ram"
        },
        {
            "type": "command",
            "key": "OS Age    ",
            "text": "/home/btw/mhm/scripts/age"
        },
        {
            "type": "uptime",
            "key": "UPTIME    "
        },
        {
            "type": "terminal",
            "key": "Terminal  "
        }
    ]
}
