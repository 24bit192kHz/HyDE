[Unit]
CollectMode=inactive-or-failed
Description=Hyprland dual-head hotplug/seat restore watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hypr-seat-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
